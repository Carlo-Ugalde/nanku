NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Webhook for confirmed reservations (existing)
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://n8n-n8n.2qhk70.easypanel.host/webhook/8b62a013-6f09-4bc6-90b3-1a6c3cfc0491
# Webhook for cancellations and reschedule proposals
N8N_CANCEL_WEBHOOK_URL=https://n8n-n8n.2qhk70.easypanel.host/webhook/81c1d40d-ef6f-49b8-a7cb-1f5dbac368d6

# ── Auto-accept reservations (see lib/auto-accept.ts) ──
# Kill switch: nothing is auto-accepted unless this is exactly "true"
AUTO_ACCEPT_ENABLED=false
# Protects /api/cron/auto-accept (send as "Authorization: Bearer <secret>"). Long random string.
CRON_SECRET=generate_a_long_random_string
# Telegram alerts: bot from @BotFather, chat id from scripts/telegram-setup.ps1
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
# Optional: link shown in conflict alerts
ADMIN_URL=https://nanku-three.vercel.app/admin
